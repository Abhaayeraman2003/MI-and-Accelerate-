# Rename to  secrets.toml  (locally) OR paste into
# Streamlit Community Cloud → App → Settings → Secrets.
#
# Leave blank to use the local ./submissions folder (good for testing).
# Fill in to save every OpCo submission to Google Cloud Storage (persistent).

gcs_bucket = "your-bucket-name"

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
client_email = "svc-mi-accelerate@your-project-id.iam.gserviceaccount.com"
client_id = "1234567890"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/svc-mi-accelerate%40your-project-id.iam.gserviceaccount.com"
