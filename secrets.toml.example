# Rename to secrets.toml locally, OR paste into Streamlit Cloud → Settings → Secrets.

# Power Automate HTTP POST URL that appends rows to the OneDrive master file:
flow_url = "https://prod-XX.westeurope.logic.azure.com:443/workflows/..../invoke?..."

# Passcode that protects the Dashboard (admin) view + master download:
admin_pin = "choose-a-strong-passcode"
